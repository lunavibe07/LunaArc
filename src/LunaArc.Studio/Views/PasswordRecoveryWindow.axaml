<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LunaArc.Studio.ViewModels"
        x:Class="LunaArc.Studio.Views.PasswordRecoveryWindow"
        x:DataType="vm:PasswordRecoveryViewModel"
        Title="Recover Password - LunaArc" Width="660" Height="650" MinWidth="560" MinHeight="620"
        Background="#F5F5F5" FontFamily="Segoe UI,Inter" FontSize="12"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">
        <StackPanel Spacing="6" Margin="0,0,0,14">
            <TextBlock Text="Recover an archive password" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Try a password list or a limited pattern. Recovery is not guaranteed." TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="9">
                <StackPanel IsEnabled="{Binding IsIdle}" Spacing="9">
                    <TextBlock Text="Archive"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Name="RecoveryArchivePath" Text="{Binding ArchivePath}" Watermark="Choose ZIP, RAR, 7z or LARC"/>
                        <Button Grid.Column="1" Content="Browse..." Click="OnBrowse" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Search method"/>
                    <ComboBox Name="RecoveryMode" SelectedIndex="{Binding ModeIndex}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Password list / unlocked vault"/>
                        <ComboBoxItem Content="Mask pattern"/>
                    </ComboBox>
                    <TextBox Name="RecoveryMask" Text="{Binding Mask}" Watermark="Example: Luna202?"/>
                    <TextBlock Text="? = 0-9, # = a-z; backslash escapes a literal ? or #. Limit: 1,000,000 candidates." TextWrapping="Wrap"/>
                    <TextBlock Text="Password list (one per line; spaces are preserved)"/>
                    <TextBox Name="RecoveryCandidates" Text="{Binding CandidateText}" AcceptsReturn="True" Height="80" PasswordChar="●"/>
                    <TextBlock Text="Encrypted vault — enter its master password to load or replace the list" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Name="VaultMasterPassword" Text="{Binding MasterPassword}" PasswordChar="●" Watermark="Master password"/>
                        <Button Grid.Column="1" Content="Load vault" Click="OnLoadVault" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="Save list" Click="OnSaveVault" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
                <TextBlock Text="Verified password"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="RecoveredPasswordBox" Text="{Binding RecoveredPassword}" IsReadOnly="True" PasswordChar="●"/>
                    <CheckBox Name="ShowRecoveredPassword" Grid.Column="1" Content="Show" IsCheckedChanged="OnShowPassword" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,14,0,14">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="8"/>
            <TextBlock Name="RecoveryStatus" Text="{Binding Status}" TextWrapping="Wrap" MinHeight="34"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="StartRecoveryButton" Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding IsIdle}"/>
            <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" IsEnabled="{Binding IsBusy}"/>
            <Button Name="CancelRecoveryButton" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/>
            <Button Name="OpenRecoveredArchiveButton" Content="Open archive" Click="OnOpen" IsEnabled="{Binding CanOpen}"/>
            <Button Name="CloseRecoveryButton" Content="Close" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
