<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:LunaArc.Studio.ViewModels"
 x:Class="LunaArc.Studio.Views.ExtractOptionsWindow" x:DataType="vm:ExtractionOptionsViewModel"
 Title="Extraction path and options - LunaArc" Width="560" Height="520" MinWidth="540" MinHeight="510"
 WindowStartupLocation="CenterOwner" RequestedThemeVariant="Dark"
 Background="#102035" FontFamily="Segoe UI,Inter" FontSize="12">
 <Window.Styles>
  <Style Selector="Button"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,3"/></Style>
  <Style Selector="RadioButton">
   <Setter Property="MinHeight" Value="20"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><ControlTemplate>
    <Grid ColumnDefinitions="13,*" Background="Transparent" MinHeight="20">
     <Ellipse Width="13" Height="13" Stroke="#D4D4D4" StrokeThickness="1" VerticalAlignment="Center"/>
     <Ellipse Width="7" Height="7" Fill="#EEEEEE" VerticalAlignment="Center" IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"/>
     <Border Grid.Column="1" BorderBrush="#888888" BorderThickness="1" Margin="2,0,0,0" IsVisible="{Binding IsFocused, RelativeSource={RelativeSource TemplatedParent}}"/>
     <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
   </ControlTemplate></Setter>
  </Style>
  <Style Selector="CheckBox">
   <Setter Property="MinHeight" Value="20"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><ControlTemplate>
    <Grid ColumnDefinitions="13,*" Background="Transparent" MinHeight="20">
     <Border Width="13" Height="13" BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center"/>
     <Path Width="11" Height="10" Data="M1,5 L4,8 L10,1" Stroke="#EEEEEE" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"/>
     <Border Grid.Column="1" BorderBrush="#888888" BorderThickness="1" Margin="2,0,0,0" IsVisible="{Binding IsFocused, RelativeSource={RelativeSource TemplatedParent}}"/>
     <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
   </ControlTemplate></Setter>
  </Style>
  <Style Selector="RadioButton:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
  <Style Selector="CheckBox:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
  <Style Selector="HeaderedContentControl.extractionGroup">
   <Setter Property="Template"><ControlTemplate>
    <Grid RowDefinitions="Auto,*">
     <Border Grid.RowSpan="2" Margin="0,7,0,0" BorderBrush="#8A8A8A" BorderThickness="1"/>
     <ContentPresenter Content="{TemplateBinding Header}" Background="#102035" Padding="3,0" Margin="6,0,0,0" HorizontalAlignment="Left"/>
     <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" Margin="9,3,9,7"/>
    </Grid>
   </ControlTemplate></Setter>
  </Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/></Style>
  <Style Selector="TextBox.destinationPath:not(:focus)"><Setter Property="Foreground" Value="Transparent"/></Style>
  <Style Selector="TreeViewItem" x:DataType="vm:ExtractionFolderNode"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/></Style>
 </Window.Styles>
 <Grid Margin="12" RowDefinitions="*,Auto">
  <TabControl Name="ExtractionTabs">
   <TabItem Header="General">
    <Grid Margin="10,12,10,8" RowDefinitions="Auto,Auto,*,Auto">
     <TextBlock Text="Destination path (will be created if it does not exist)" Margin="0,0,0,6"/>
     <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <Grid ToolTip.Tip="{Binding Destination}">
       <TextBox Name="DestinationBox" Classes="destinationPath" Text="{Binding Destination}" MinHeight="30" VerticalContentAlignment="Center" GotFocus="OnDestinationFocused" LostFocus="OnDestinationUnfocused"/>
       <TextBlock Name="DestinationPreview" Text="{Binding DestinationPreview}" IsVisible="{Binding !IsFocused, ElementName=DestinationBox}" IsHitTestVisible="False" Margin="9,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <Button Name="BrowseDestinationButton" Grid.Column="1" Content="Browse..." Click="OnBrowse" Margin="8,0,0,0" Width="88"/>
     </Grid>
     <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
      <StackPanel Spacing="6">
       <HeaderedContentControl Name="UpdatemodeGroup" Classes="extractionGroup" Header="Update mode">
        <StackPanel>
         <RadioButton Name="ExtractAndReplaceRadio" GroupName="Update" Content="Extract and replace files" IsChecked="{Binding ExtractAndReplace}"/>
         <RadioButton Name="ExtractAndUpdateRadio" GroupName="Update" Content="Extract and update files" IsChecked="{Binding ExtractAndUpdate}"/>
         <RadioButton Name="FreshenExistingRadio" GroupName="Update" Content="Freshen existing files only" IsChecked="{Binding FreshenExisting}"/>
        </StackPanel>
       </HeaderedContentControl>
       <HeaderedContentControl Name="OverwritemodeGroup" Classes="extractionGroup" Header="Overwrite mode">
        <StackPanel>
         <RadioButton Name="AskOverwriteRadio" GroupName="Overwrite" Content="Ask before overwrite" IsChecked="{Binding AskBeforeOverwrite}"/>
         <RadioButton Name="OverwriteAllRadio" GroupName="Overwrite" Content="Overwrite without prompt" IsChecked="{Binding OverwriteAll}"/>
         <RadioButton Name="SkipExistingBox" GroupName="Overwrite" Content="Skip existing files" IsChecked="{Binding SkipExisting}"/>
         <RadioButton Name="RenameRadio" GroupName="Overwrite" Content="Rename automatically" IsChecked="{Binding RenameAutomatically}"/>
        </StackPanel>
       </HeaderedContentControl>
       <HeaderedContentControl Name="MiscellaneousGroup" Classes="extractionGroup" Header="Miscellaneous">
        <StackPanel>
         <CheckBox Name="KeepBrokenFilesBox" Content="Keep broken files" IsChecked="{Binding KeepBrokenFiles}" ToolTip.Tip="Keep available failed output under a unique .broken name. Supported by ZIP, LARC and SharpCompress extraction; TAR does not retain partial files."/>
         <CheckBox Name="DisplayAfterExtractionBox" Content="{Binding DisplayFilesLabel}" IsChecked="{Binding DisplayAfterExtraction}"/>
        </StackPanel>
       </HeaderedContentControl>
       <TextBlock Text="Skip preserves existing files in every update mode. Choose Ask or Overwrite to update older copies." TextWrapping="Wrap" Foreground="#BDBDBD" Margin="0,4,0,0"/>
      </StackPanel>
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
       <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBlock Text="Folders" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Name="NewFolderButton" Grid.Column="1" Content="New folder" Click="OnNewFolder"/>
       </Grid>
       <Border Grid.Row="1" BorderBrush="#737373" BorderThickness="1" Background="#202020">
        <TreeView Name="DestinationTree" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}">
         <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:ExtractionFolderNode" ItemsSource="{Binding Children}">
           <StackPanel Orientation="Horizontal" Spacing="7" ToolTip.Tip="{Binding Error}">
            <PathIcon Width="14" Height="12" Foreground="#EBC45B" Data="M1,2 L6,2 L8,4 L15,4 L15,13 L1,13 Z"/>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
           </StackPanel>
          </TreeDataTemplate>
         </TreeView.ItemTemplate>
        </TreeView>
       </Border>
      </Grid>
     </Grid>
     <TextBlock Grid.Row="3" Name="ExtractionValidation" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#FFD18B" Margin="0,10,0,0"/>
    </Grid>
   </TabItem>
   <TabItem Name="ExtractionPasswordTab" Header="Password" IsVisible="{Binding RequiresPassword}">
    <StackPanel Margin="14" Spacing="10">
     <TextBlock Text="Archive password" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="Enter the password supplied with the archive. Leave blank to use the password already unlocked for this archive." TextWrapping="Wrap" Foreground="#BDBDBD"/>
     <TextBox Name="ExtractionPasswordBox" Text="{Binding Password}" PasswordChar="{Binding PasswordCharacter}" Watermark="Password (if required)"/>
     <CheckBox Name="ShowExtractionPasswordBox" Content="Show password" IsChecked="{Binding ShowPassword}"/>
     <TextBlock Text="The password is cleared when this dialog closes." Foreground="#BDBDBD"/>
    </StackPanel>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
   <Button Name="StartExtractionButton" Grid.Column="1" Content="OK" Width="85" IsDefault="True" Click="OnExtract"/>
   <Button Name="CancelExtractionButton" Grid.Column="2" Content="Cancel" Width="85" Margin="8,0,0,0" IsCancel="True" Click="OnCancel"/>
   <Button Grid.Column="3" Content="Help" Width="85" Margin="8,0,0,0" Click="OnHelp"/>
  </Grid>
 </Grid>
</Window>
