<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:LunaArc.Studio.ViewModels" x:Class="LunaArc.Studio.Views.ArchiveOptionsWindow"
 x:DataType="vm:CompressionOptionsViewModel" Title="Archive name and parameters - LunaArc"
 Width="630" Height="710" MinWidth="600" MinHeight="670" RequestedThemeVariant="Dark"
 Background="#102035" FontFamily="Segoe UI,Inter" FontSize="12" WindowStartupLocation="CenterOwner">
 <Window.Styles>
  <Style Selector="Button"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,3"/></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="RadioButton"><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="CheckBox"><Setter Property="FontSize" Value="12"/></Style>
 </Window.Styles>
 <Grid Margin="12" RowDefinitions="*,Auto">
  <TabControl Name="CompressionTabs">
   <TabItem Header="General">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="12" Spacing="12">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
       <TextBlock Text="Archive name" VerticalAlignment="Center"/>
       <Button Name="BrowseArchiveButton" Grid.Column="1" Content="Browse..." IsEnabled="{Binding IsCreation}" Click="OnBrowse"/>
       <TextBox Name="ArchiveNameBox" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ArchiveName}" IsEnabled="{Binding IsCreation}" Margin="0,6,0,0"/>
      </Grid>
      <Grid ColumnDefinitions="*,14,*">
       <StackPanel Spacing="12">
        <Border BorderBrush="#737373" BorderThickness="1" Padding="10,8">
         <StackPanel>
          <TextBlock Text="Archive format" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <RadioButton Name="LarcFormatRadio" GroupName="Format" Content="LARC (.larc)" IsChecked="{Binding IsLarc}"/>
          <RadioButton Name="ZipFormatRadio" GroupName="Format" Content="ZIP (.zip)" IsChecked="{Binding IsZip}"/>
          <RadioButton Name="TarFormatRadio" GroupName="Format" Content="TAR GZip (.tar.gz)" IsChecked="{Binding IsTarGzip}"/>
          <RadioButton Name="SevenZipFormatRadio" GroupName="Format" Content="7z (.7z)" IsChecked="{Binding IsSevenZip}"/>
         </StackPanel>
        </Border>
        <StackPanel Spacing="5">
         <TextBlock Text="Compression method"/>
         <ComboBox Name="LevelPicker" SelectedIndex="{Binding SelectedLevelIndex}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Store"/><ComboBoxItem Content="Fastest"/><ComboBoxItem Content="Fast"/>
          <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Good"/><ComboBoxItem Content="Best"/>
         </ComboBox>
        </StackPanel>
        <TextBlock Text="{Binding FormatNote}" TextWrapping="Wrap" Foreground="#BDBDBD"/>
        <TextBlock Text="Deletion is off by default. It forces testing and uses temporary extraction space. Changed or unarchived sources are kept." Foreground="#BDBDBD" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Spacing="12">
        <StackPanel Spacing="6">
         <TextBlock Text="Archive mode"/>
         <Border BorderBrush="#737373" BorderThickness="1" Padding="8,7"><TextBlock Text="Create new archive"/></Border>
         <TextBlock Text="Choose an unused file name. Existing archives are preserved." Foreground="#BDBDBD" TextWrapping="Wrap"/>
        </StackPanel>
        <Border BorderBrush="#737373" BorderThickness="1" Padding="10,8">
         <StackPanel>
          <TextBlock Text="Archiving options" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <CheckBox Name="DeleteSourceAfterArchivingBox" Content="Delete files after archiving" IsChecked="{Binding DeleteSourceAfterArchiving}" IsEnabled="{Binding CanDeleteSources}" ToolTip.Tip="Requires archive and source-content verification. Applies to this creation only. Unavailable for the nested TAR GZip encryption wrapper."/>
          <CheckBox Name="CreateSfxBox" Content="Create SFX archive" IsChecked="{Binding CreateSfx}" IsEnabled="{Binding CanCreateSfx}" ToolTip.Tip="Self-contained extractor for the current OS/architecture. Available in published packages. Adds the LunaArc executable size."/>
          <CheckBox Name="CreateSolidBox" Content="Create solid archive" IsChecked="{Binding SolidArchive}" IsEnabled="{Binding CanUseSolid}" ToolTip.Tip="Select 7z. Compresses files together using LZMA2."/>
          <CheckBox Name="RecoveryRecordBox" Content="Add recovery record" IsChecked="{Binding AddRecoveryRecord}" IsEnabled="{Binding IsCreation}" ToolTip.Tip="Creates a .lrec companion. Repairs one damaged 1 MiB block per group of 16 blocks. Keep it beside the archive."/>
          <CheckBox Name="TestCreatedArchiveBox" Content="Test archived files" IsChecked="{Binding TestCreatedArchive}" IsEnabled="{Binding CanToggleTest}" ToolTip.Tip="Testing is required when deleting source files."/>
          <CheckBox Name="LockArchiveBox" Content="Lock archive" IsChecked="{Binding LockArchive}" IsEnabled="{Binding IsCreation}" ToolTip.Tip="Creates a .lunalock companion and marks the archive read-only. Advisory protection in LunaArc, not encryption. Unlock using Tools."/>
          <TextBlock Text="Solid: 7z only. SFX: published package, current OS. Keep .lrec / .lunalock companions. These are LunaArc features, not RAR records." TextWrapping="Wrap" Foreground="#BDBDBD" FontSize="11" Margin="0,6,0,0"/>
         </StackPanel>
        </Border>
        <Button Name="SetArchivePasswordButton" Content="Set password..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnSetPassword"/>
        <TextBlock Text="{Binding PasswordSummary}" Foreground="#BDBDBD"/>
       </StackPanel>
      </Grid>
      <Expander Header="Archive comment" HorizontalAlignment="Stretch">
       <TextBox Name="ArchiveCommentBox" Text="{Binding ArchiveComment}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Watermark="Optional comment for LARC / ZIP"/>
      </Expander>
      <TextBlock Text="{Binding SourceSummary}" Foreground="#BDBDBD"/>
      <TextBlock Name="CompressionValidation" Text="{Binding Status}" Foreground="#FFD18B" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
   <Button Name="AcceptOptionsButton" Content="OK" Width="85" IsDefault="True" Click="OnAcceptClicked"/>
   <Button Name="CancelOptionsButton" Content="Cancel" Width="85" IsCancel="True" Click="OnCancelClicked"/>
   <Button Name="CompressionHelpButton" Content="Help" Width="85" Click="OnHelp"/>
  </StackPanel>
 </Grid>
</Window>
