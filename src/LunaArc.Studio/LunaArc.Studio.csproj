    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/NocturneBackground.png" />
    <AvaloniaResource Include="../../branding/app_logo.ico" Link="Assets/app_logo.ico" />
    <AvaloniaResource Include="../../branding/app_logo_256.png" Link="Assets/app_logo.png" />
    <ProjectReference Include="..\LunaArc.Core\LunaArc.Core.csproj" />
