<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:LunaArc.Studio.ViewModels" xmlns:model="using:LunaArc.Studio.Models"
 x:Class="LunaArc.Studio.Views.HelpTopicsWindow" x:DataType="vm:HelpTopicsViewModel"
 Title="LunaArc Help" Width="920" Height="650" MinWidth="700" MinHeight="460"
 WindowStartupLocation="CenterOwner" RequestedThemeVariant="Light" Background="#F0F0F0" FontSize="12">
 <Window.DataTemplates>
  <TreeDataTemplate DataType="model:HelpTopic" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Title}"/></TreeDataTemplate>
 </Window.DataTemplates>
 <Grid RowDefinitions="Auto,*,Auto">
  <Border Background="#F7F7F7" BorderBrush="#BFC4CA" BorderThickness="0,0,0,1" Padding="8">
   <StackPanel Orientation="Horizontal" Spacing="6">
    <Button Name="HelpNavigationButton" Content="{Binding NavigationButtonText}" Command="{Binding ToggleNavigationCommand}"/>
    <Button Name="HelpBackButton" Content="Back" Command="{Binding BackCommand}"/>
    <Button Name="HelpForwardButton" Content="Forward" Command="{Binding ForwardCommand}"/>
    <Button Name="HelpHomeButton" Content="Home" Command="{Binding HomeCommand}"/>
    <Button Name="HelpFavoriteButton" Content="{Binding FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
   <Border Name="HelpNavigationPane" IsVisible="{Binding ShowNavigation}" Width="285" BorderBrush="#BFC4CA" BorderThickness="0,0,1,0" Padding="5">
    <TabControl Name="HelpNavigationTabs" FontSize="11">
     <TabItem Padding="7,6"><TabItem.Header><TextBlock Text="Contents" FontSize="12"/></TabItem.Header>
      <TreeView Name="HelpContentsTree" ItemsSource="{Binding Contents}" SelectedItem="{Binding SelectedTopic, Mode=OneWay}" SelectionChanged="OnTopicSelected" Background="White">
       <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True"/></Style></TreeView.Styles>
      </TreeView>
     </TabItem>
     <TabItem Padding="7,6"><TabItem.Header><TextBlock Text="Index" FontSize="12"/></TabItem.Header><ListBox Name="HelpIndexList" ItemsSource="{Binding Index}" SelectedItem="{Binding SelectedTopic, Mode=OneWay}" SelectionChanged="OnTopicSelected" Background="White"/></TabItem>
     <TabItem Padding="7,6"><TabItem.Header><TextBlock Text="Search" FontSize="12"/></TabItem.Header>
      <Grid RowDefinitions="Auto,Auto,*">
       <TextBox Name="HelpSearchBox" Text="{Binding SearchText}" Watermark="Search help" MaxLength="200" Margin="0,5"/>
       <TextBlock Grid.Row="1" Text="{Binding SearchSummary}" TextWrapping="Wrap" Margin="3,4"/>
       <ListBox Name="HelpSearchResults" Grid.Row="2" ItemsSource="{Binding SearchResults}" SelectionChanged="OnTopicSelected" Background="White"/>
      </Grid>
     </TabItem>
     <TabItem Padding="7,6"><TabItem.Header><TextBlock Text="Favorites" FontSize="12"/></TabItem.Header><ListBox Name="HelpFavoritesList" ItemsSource="{Binding Favorites}" SelectionChanged="OnTopicSelected" Background="White"/></TabItem>
    </TabControl>
   </Border>
   <Border Grid.Column="1" Background="White" Padding="24,20">
   <ScrollViewer Name="HelpArticleScroll" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18">
     <TextBlock Name="HelpArticleTitle" Text="{Binding SelectedTopic.Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#173F65"/>
     <Border Height="1" Background="#D7E4F0"/>
     <TextBlock Name="HelpArticleBody" Text="{Binding SelectedTopic.Body}" FontSize="14" LineHeight="23" TextWrapping="Wrap"/>
     <TextBlock Text="Related topics" FontWeight="SemiBold" Margin="0,10,0,0"/>
     <ItemsControl ItemsSource="{Binding RelatedTopics}">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="model:HelpTopic">
       <Button Content="{Binding Title}" Click="OnRelatedTopicClicked" Background="Transparent" BorderThickness="0" Foreground="#0759A0" Padding="0,6" HorizontalAlignment="Left"/>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#BFC4CA" BorderThickness="0,1,0,0" Padding="10,6"><TextBlock Text="{Binding Status}"/></Border>
 </Grid>
</Window>
