<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LunaArc.Studio.ViewModels"
        x:Class="LunaArc.Studio.Views.ArchiveOptionsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Archive options" Width="470" Height="410" CanResize="False"
        Background="#F3F3F3" FontFamily="Segoe UI,Inter" FontSize="12"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="18" ColumnDefinitions="130,*">
        <TextBlock Text="Archive format:" VerticalAlignment="Center" />
        <ComboBox Name="FormatPicker" Grid.Column="1" SelectedIndex="{Binding SelectedFormatIndex}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <ComboBoxItem Content="LunaArc (.larc)" /><ComboBoxItem Content="ZIP (.zip)" /><ComboBoxItem Content="TAR GZip (.tar.gz)" />
        </ComboBox>
        <TextBlock Grid.Row="1" Text="Compression level:" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding SelectedLevelIndex}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <ComboBoxItem Content="Store" /><ComboBoxItem Content="Fastest" /><ComboBoxItem Content="Fast" />
            <ComboBoxItem Content="Normal" /><ComboBoxItem Content="Good" /><ComboBoxItem Content="Best" />
        </ComboBox>
        <TextBlock Grid.Row="2" Text="Archive password:" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PasswordInput}" PasswordChar="●" Watermark="Optional" Margin="0,0,0,8" />
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Password is used to open encrypted archives. Only .larc output supports encryption." TextWrapping="Wrap" Foreground="#646B72" Margin="0,0,0,14" />
        <Grid Grid.Row="4" Grid.ColumnSpan="2" RowDefinitions="Auto,*">
            <TextBlock Text="Archive comment:" Margin="0,0,0,6" />
            <TextBox Grid.Row="1" Text="{Binding ArchiveComment}" AcceptsReturn="True" TextWrapping="Wrap" />
        </Grid>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Name="AcceptOptionsButton" Content="OK" Width="85" HorizontalContentAlignment="Center" Click="OnAcceptClicked" IsDefault="True" />
            <Button Name="CancelOptionsButton" Content="Cancel" Width="85" HorizontalContentAlignment="Center" Click="OnCancelClicked" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
